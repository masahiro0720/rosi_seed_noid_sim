<?xml version="1.0"?>
<sdf version="1.5">
  <world name="default">
    <gui>
      <camera name="user_camera">
        <pose>-4 -6 3 0 0.35 0.9</pose>
      </camera>
    </gui>

    <physics type="ode">
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>0.0</real_time_update_rate>
      <max_step_size>0.002</max_step_size>
    </physics>

    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.1 0.1 0.1 1</background>
    </scene>

    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <actor name="sim_person">
      <pose>0 0 0 0 0 0</pose>
      <skin>
        <filename>file://media/models/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="standing">
        <filename>file://media/models/walk.dae</filename>
        <scale>1.0</scale>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="standing">
          <waypoint>
            <time>0.0</time>
            <pose>3 0 0 0 0 3.14159265359</pose>
          </waypoint>
          <waypoint>
            <time>1.0</time>
            <pose>3 0 0 0 0 3.14159265359</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>
  </world>
</sdf>
