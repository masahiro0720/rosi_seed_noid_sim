<?xml version="1.0"?>
<package format="2">
  <name>rosi_seed_noid_sim</name>
  <version>0.4.0</version>
  <description>
    Reproducible Gazebo simulation backends for the RoSI SEED-Noid HRI system.
  </description>

  <maintainer email="220447031@ccmailg.meijo-u.ac.jp">masahiro0720</maintainer>
  <license>BSD-3-Clause</license>

  <url type="repository">https://github.com/masahiro0720/rosi_seed_noid_sim</url>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>actionlib</depend>
  <depend>actionlib_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>gazebo_ros</depend>
  <depend>global_planner</depend>
  <depend>geometry_msgs</depend>
  <depend>move_base</depend>
  <depend>move_base_msgs</depend>
  <depend>rois_env</depend>
  <depend>rospy</depend>
  <depend>seed_r7_gazebo</depend>
  <depend>seed_r7_navigation</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>teb_local_planner</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <build_depend>message_generation</build_depend>
  <exec_depend>message_runtime</exec_depend>

  <exec_depend>python3-opencv</exec_depend>

  <test_depend>python3-nose</test_depend>

  <export/>
</package>
